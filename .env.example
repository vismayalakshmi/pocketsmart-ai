# Google Gemini API key
# Leave blank if you want to run the project in demo mode.
GEMINI_API_KEY=your_google_gemini_api_key_here

# Gemini model
GEMINI_MODEL=gemini-2.5-flash

# Session security secret
SESSION_SECRET=change-this-to-a-long-random-secret

# SQLite database
DATABASE_PATH=pocketsmart.db

# true = application works without Gemini API
# false = use Gemini API
DEMO_MODE=true